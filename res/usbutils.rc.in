// Windows application icon + version info for USBUtils.
// Configured by CMake (configure_file) from res/usbutils.rc.in — the
// version numbers and description are baked in as plain literals, which
// windres (MinGW) and rc.exe (MSVC) both parse without preprocessor
// tricks. The multi-size .ico covers 16..256 px (Explorer, taskbar,
// alt-tab).
#include <windows.h>

IDI_ICON1 ICON "@USBUTILS_ICON_PATH@"

1 VERSIONINFO
FILEVERSION     @USBUTILS_VER_MAJOR@,@USBUTILS_VER_MINOR@,@USBUTILS_VER_PATCH@,0
PRODUCTVERSION  @USBUTILS_VER_MAJOR@,@USBUTILS_VER_MINOR@,@USBUTILS_VER_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AldySan / USBUtils contributors"
            VALUE "FileDescription",  "@USBUTILS_RC_DESC@"
            VALUE "FileVersion",      "@USBUTILS_VER_STRING@"
            VALUE "InternalName",     "@USBUTILS_RC_NAME@"
            VALUE "LegalCopyright",   "MIT License (c) 2026 USBUtils contributors. Reverse-engineered from USBUtil v2.2 rev1.0 by ISEKO."
            VALUE "OriginalFilename", "@USBUTILS_RC_NAME@"
            VALUE "ProductName",      "USBUtils"
            VALUE "ProductVersion",   "@USBUTILS_VER_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
